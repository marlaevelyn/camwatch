#!/bin/bash
# Choose what camwatch reacts to: the camera (video), the mic, or both.
#
#   ./set-trigger                  show which triggers are on
#   ./set-trigger <video|mic>      flip that trigger on/off
#   ./set-trigger <video|mic> <on|off>
#
# A disabled trigger counts as off: with video off, a call with camera and mic
# shows mic (purple); with mic off, a mic-only call shows off (copies the
# reference bulb).
# The choice is saved as video.disabled / mic.disabled in this folder and takes
# effect immediately.

set -euo pipefail

dir="$(cd "$(dirname "$0")" && pwd)"
label="com.camwatch"
domain="gui/$(id -u)"

show() {
  for trigger in video mic; do
    if [ -e "$dir/$trigger.disabled" ]; then echo "$trigger: off"; else echo "$trigger: on"; fi
  done
}

usage() {
  echo "usage: ./set-trigger [video|mic] [on|off]" >&2
  exit 64
}

if [ $# -eq 0 ]; then
  show
  exit 0
fi

trigger="$1"
case "$trigger" in video | mic) ;; *) usage ;; esac
flag="$dir/$trigger.disabled"

case "${2:-toggle}" in
  on) want=on ;;
  off) want=off ;;
  toggle) if [ -e "$flag" ]; then want=on; else want=off; fi ;;
  *) usage ;;
esac
[ $# -le 2 ] || usage

if [ "$want" = on ]; then rm -f "$flag"; else touch "$flag"; fi
show
if [ -e "$dir/video.disabled" ] && [ -e "$dir/mic.disabled" ]; then
  echo "Both triggers are off, so the bulb will always copy the reference bulb."
fi

# Restart camwatch so it re-reads the state and sets the bulb now; a running
# watcher would otherwise keep its old idea of the last state.
if launchctl print "$domain/$label" >/dev/null 2>&1; then
  launchctl kickstart -k "$domain/$label"
elif [ -x "$dir/camwatch" ]; then
  code=0
  "$dir/camwatch" status >/dev/null || code=$?
  case "$code" in 0) state=video ;; 2) state=mic ;; *) state=off ;; esac
  "$dir/on-change.sh" "$state"
fi
