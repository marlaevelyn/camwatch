#!/usr/bin/env python3
"""Choose which WiZ bulb(s) camwatch controls, and set their color.

  ./set-bulb                    list WiZ bulbs on the network (* = controlled now)
  ./set-bulb <ip|mac> ...       control these bulbs from now on
  ./set-bulb color R G B        set the controlled bulbs to this color (used by on-change.sh)
  ./set-bulb color R G B --refresh
                                camwatch's 5-minute re-check: fix only bulbs that
                                missed an update, leaving hand-set bulbs alone

The choice is saved to bulb.conf (one "ip mac" per line), which is read on
every change, so it takes effect without restarting camwatch.

`color` waits for each bulb to confirm and retries for about a minute. If a
bulb stops answering, it searches the network for the bulb's MAC and updates
bulb.conf when the bulb has a new IP.
"""
import json
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
CONF = HERE / "bulb.conf"
PORT = 38899


def discover(seconds=3.0):
    """Broadcast getPilot and collect replies: {ip: pilot result}."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    sock.settimeout(0.5)
    found = {}
    end = time.time() + seconds
    while time.time() < end:
        sock.sendto(b'{"method":"getPilot","params":{}}', ("255.255.255.255", PORT))
        try:
            while True:
                data, (ip, _) = sock.recvfrom(4096)
                try:
                    found[ip] = json.loads(data).get("result", {})
                except ValueError:
                    pass
        except socket.timeout:
            pass
    return found


def normalize_mac(text):
    return text.lower().replace(":", "").replace("-", "")


def configured():
    """[(ip, mac)] from bulb.conf."""
    if not CONF.exists():
        return []
    return [tuple((line.split() + [""])[:2]) for line in CONF.read_text().splitlines() if line.strip()]


def save(bulbs):
    CONF.write_text("".join(f"{ip} {mac}\n" for ip, mac in bulbs))


def relocate(lost):
    """Find bulbs that stopped answering by MAC. Returns {old_ip: new_ip}."""
    if not any(lost.values()):
        return {}
    by_mac = {normalize_mac(pilot.get("mac", "")): ip for ip, pilot in discover().items()}
    moved = {ip: by_mac[mac] for ip, mac in lost.items() if mac and by_mac.get(mac, ip) != ip}
    if moved:
        save([(moved.get(ip, ip), mac) for ip, mac in configured()])
        for old, new in moved.items():
            print(f"[set-bulb] bulb {lost[old]} moved from {old} to {new}; updated bulb.conf", flush=True)
    return moved


def exchange(message, bulbs, accept, delays, relocate_after=None):
    """Send `message` to each bulb ({ip: mac}) until it sends a reply that
    `accept`s, waiting `delays[i]` seconds before attempt i. After attempt
    `relocate_after`, look for silent bulbs by MAC in case their IP changed.
    Returns ({ip: reply}, {ip: mac} of bulbs that never answered)."""
    pending = dict(bulbs)
    replies = {}
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    for attempt, delay in enumerate(delays):
        time.sleep(delay)
        for ip in pending:
            sock.sendto(message, (ip, PORT))
        deadline = time.time() + 1
        while pending and time.time() < deadline:
            sock.settimeout(max(0.05, deadline - time.time()))
            try:
                data, (ip, _) = sock.recvfrom(4096)
            except socket.timeout:
                break
            try:
                reply = json.loads(data)
            except ValueError:
                continue
            if ip in pending and accept(reply):
                replies[ip] = reply
                del pending[ip]
        if not pending:
            break
        if attempt == relocate_after:
            for old, new in relocate(pending).items():
                pending[new] = pending.pop(old)
    return replies, pending


# camwatch sets its colors at this brightness instead of 100%. The 1% difference
# isn't visible, but it marks the bulb's setting as camwatch's: a bulb showing
# any other brightness, a scene, or switched off was changed by hand.
SIGNATURE_DIMMING = 99


def set_by_camwatch(pilot):
    return (pilot.get("state") is True and pilot.get("dimming") == SIGNATURE_DIMMING
            and not pilot.get("sceneId") and "r" in pilot)


def apply_color(r, g, b, refresh=False):
    """Set every configured bulb to this color, retrying until each one confirms.

    With refresh (camwatch's 5-minute re-check), only correct bulbs that still
    show a camwatch color that is now wrong, i.e. ones that missed an update.
    A bulb someone changed by hand is left alone until the next real change."""
    bulbs = dict(configured())  # ip -> mac
    if not bulbs:
        if not refresh:
            print("[set-bulb] no bulb configured; run ./set-bulb", flush=True)
        return

    if refresh:
        replies, _ = exchange(b'{"method":"getPilot","params":{}}', bulbs,
                              lambda reply: reply.get("method") == "getPilot" and "result" in reply,
                              delays=[0, 0], relocate_after=0)
        bulbs = {ip: mac for ip, mac in configured()
                 if ip in replies and set_by_camwatch(current := replies[ip]["result"])
                 and (current.get("r"), current.get("g"), current.get("b")) != (r, g, b)}
        if not bulbs:
            return

    pilot = json.dumps({"method": "setPilot", "params": {
        "state": True, "r": r, "g": g, "b": b, "dimming": SIGNATURE_DIMMING}}).encode()
    confirmed = lambda reply: reply.get("method") == "setPilot" and reply.get("result", {}).get("success") is True
    if refresh:
        exchange(pilot, bulbs, confirmed, delays=[0, 0])
        return

    # About a minute of retries in total for a real change.
    _, missed = exchange(pilot, bulbs, confirmed, delays=[0, 1, 2, 4, 8, 15, 30], relocate_after=1)
    for ip, mac in missed.items():
        print(f"[set-bulb] bulb {ip} ({mac}) not responding; "
              "camwatch will retry at its next 5-minute check", flush=True)


def describe(pilot):
    if not pilot.get("state"):
        return "off"
    if "r" in pilot:
        return f"on  rgb({pilot['r']},{pilot['g']},{pilot['b']})"
    return "on"


def list_bulbs():
    current_ips = {ip for ip, _ in configured()}
    print("Looking for WiZ bulbs...")
    found = discover()
    if not found:
        sys.exit("No WiZ bulbs answered. Is this Mac on the same Wi-Fi as the bulbs? "
                 "A VPN can also block access to devices on your home network.")
    for ip in sorted(found, key=lambda ip: tuple(int(part) for part in ip.split("."))):
        mark = "*" if ip in current_ips else " "
        print(f"{mark} {ip:<15} {found[ip].get('mac', '?'):<13} {describe(found[ip])}")
    missing = current_ips - set(found)
    for ip in sorted(missing):
        print(f"* {ip:<15} (configured, but did not answer)")
    if not current_ips:
        print("\nNo bulb configured yet. Run: ./set-bulb <ip or mac>")


def set_bulbs(targets):
    found = discover()
    by_mac = {normalize_mac(pilot.get("mac", "")): ip for ip, pilot in found.items()}
    chosen = []
    for target in targets:
        ip = target if target in found else by_mac.get(normalize_mac(target))
        if not ip:
            sys.exit(f"No WiZ bulb answered at {target}. Run ./set-bulb with no arguments to list bulbs.")
        chosen.append((ip, found[ip].get("mac", "")))

    save(chosen)
    for ip, mac in chosen:
        print(f"camwatch now controls {ip} ({mac})", flush=True)

    # Show the current state on the new bulb(s) right away.
    code = subprocess.run([HERE / "camwatch", "status"], capture_output=True).returncode
    state = {0: "video", 2: "mic"}.get(code, "off")
    subprocess.run([HERE / "on-change.sh", state], check=False)


if __name__ == "__main__":
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
    elif args and args[0] == "color":
        rgb = [arg for arg in args[1:] if arg != "--refresh"]
        if len(rgb) != 3 or not all(value.isdigit() and int(value) <= 255 for value in rgb):
            sys.exit("usage: ./set-bulb color R G B [--refresh]   (each 0-255)")
        apply_color(*map(int, rgb), refresh="--refresh" in args)
    elif args:
        set_bulbs(args)
    else:
        list_bulbs()
